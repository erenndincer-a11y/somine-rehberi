---
import Logo from './Logo.astro';
import { SITE, topCategories, subcategoriesOf, categoryUrl } from '../site.config';

const nav = topCategories.map((c) => ({
  href: categoryUrl(c.slug),
  label: c.name,
  children: subcategoriesOf(c.slug).map((s) => ({ href: categoryUrl(s.slug), label: s.name })),
}));
const path = Astro.url.pathname;
const linkCls =
  'rounded-btn px-2.5 py-2 text-[15px] text-ink-secondary transition-colors hover:text-ink aria-[current=page]:text-ink';
const itemCls = 'block px-4 py-2.5 text-[15px] text-ink-secondary transition-colors hover:bg-surface-subtle hover:text-ink';
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
    <a href="/" aria-label={SITE.name}><Logo /></a>
    <nav class="flex items-center" aria-label="Ana gezinme">
      <ul class="hidden items-center xl:flex">
        {
          nav.map((l) =>
            l.children.length ? (
              <li class="relative">
                <details class="group/sub">
                  <summary
                    class={`${linkCls} flex cursor-pointer list-none items-center gap-1 [&::-webkit-details-marker]:hidden`}
                  >
                    {l.label}
                    <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true" class="transition-transform group-open/sub:rotate-180">
                      <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </summary>
                  <ul class="disclosure-panel absolute left-0 top-11 z-50 min-w-52 overflow-hidden rounded-card border border-border bg-surface py-1 shadow-float">
                    <li>
                      <a href={l.href} class={`${itemCls} font-[550] text-ink`}>
                        Tüm {l.label.toLocaleLowerCase('tr')}
                      </a>
                    </li>
                    {l.children.map((c) => (
                      <li>
                        <a href={c.href} class={itemCls}>
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={l.href} aria-current={path === l.href ? 'page' : undefined} class={`${linkCls} block`}>
                  {l.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <!-- Mobil/tablet menü: JS gerektirmeyen <details>, xl ve üstünde gizli -->
      <div class="relative xl:hidden">
        <details class="group/menu">
          <summary
            class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-btn text-ink-secondary transition-colors hover:text-ink [&::-webkit-details-marker]:hidden"
            aria-label="Menü"
          >
            <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
              <path d="M1 1h16M1 7h16M1 13h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
          </summary>
          <ul
            class="disclosure-panel absolute right-0 top-12 z-50 max-h-[80vh] min-w-56 overflow-y-auto rounded-card border border-border bg-surface py-1 shadow-float"
          >
            {
              nav.map((l) => (
                <>
                  <li>
                    <a href={l.href} class={itemCls}>
                      {l.label}
                    </a>
                  </li>
                  {l.children.map((c) => (
                    <li>
                      <a href={c.href} class={`${itemCls} pl-8 text-[14px]`}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </>
              ))
            }
            <li class="mt-1 border-t border-border pt-1"><a href="/galeri" class={itemCls}>Galeri</a></li>
            <li><a href="/hakkimizda" class={itemCls}>Hakkımızda</a></li>
          </ul>
        </details>
      </div>
    </nav>
  </div>
</header>
