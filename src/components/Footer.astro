const year = new Date().getFullYear();
const domain = new URL(SITE.url).hostname;
---

<footer class="mt-24 border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-5 py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <Logo />
        <p class="mt-4 max-w-xs text-[15px] leading-6 text-ink-secondary">
          Model seçimi, kurulum ve bakım rehberleri — şömine üzerine bağımsız bir editoryal yayın.
        </p>
      </div>
      <nav aria-label="Kategoriler">
        <h2 class="eyebrow">Kategoriler</h2>
        <ul class="mt-4 space-y-2 text-[15px]">
          {
            CATEGORIES.map((c) => (
              <li class={c.parent ? 'pl-3 text-[14px]' : ''}>
                <a class="text-ink-secondary transition-colors hover:text-ink" href={categoryUrl(c.slug)}>
                  {c.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Site">
        <h2 class="eyebrow">Site</h2>
        <ul class="mt-4 space-y-2.5 text-[15px]">
          <li><a class="text-ink-secondary transition-colors hover:text-ink" href="/galeri">Galeri</a></li>
          <li><a class="text-ink-secondary transition-colors hover:text-ink" href="/hakkimizda">Hakkımızda</a></li>
          <li><a class="text-ink-secondary transition-colors hover:text-ink" href="/iletisim">İletişim</a></li>
          <li><a class="text-ink-secondary transition-colors hover:text-ink" href="/rss.xml">RSS</a></li>
        </ul>
      </nav>
      <nav aria-label="Yasal">
        <h2 class="eyebrow">Yasal</h2>
        <ul class="mt-4 space-y-2.5 text-[15px]">
          <li><a class="text-ink-secondary transition-colors hover:text-ink" href="/gizlilik-politikasi">Gizlilik politikası</a></li>
          <li><a class="text-ink-secondary transition-colors hover:text-ink" href="/cerez-politikasi">Çerez politikası</a></li>
          <li><a class="text-ink-secondary transition-colors hover:text-ink" href="/kullanim-kosullari">Kullanım koşulları</a></li>
        </ul>
      </nav>
    </div>
    <div class="mt-12 border-t border-border pt-6">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
        <p class="text-[13px] leading-[18px] text-ink-secondary">
          Yazı işleri ve her tür soru için:
          <a class="underline underline-offset-2 hover:text-ink" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
        <nav aria-label="Sosyal medya">
          <ul class="-m-3 flex items-center gap-1">
            {
              SITE.socials.map((s) => (
                <li>
                  <a
                    class="flex h-11 w-11 items-center justify-center text-ink opacity-60 transition-opacity duration-200 ease-site hover:opacity-100"
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.label}
                  >
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d={icons[s.name]} />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <p class="mt-3 text-[13px] leading-[18px] text-ink-secondary">
        © {year} {SITE.name} · {domain} — Tüm hakları saklıdır.
      </p>
    </div>
  </div>
</footer>
