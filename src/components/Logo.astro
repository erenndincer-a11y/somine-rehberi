---
// Marka logosu: bordo kare içinde alev ikonu + "şömine rehberi" kelime markası.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg viewBox="0 0 48 48" class="h-8 w-8 shrink-0" aria-hidden="true">
    <rect width="48" height="48" rx="11" fill="var(--color-accent)"></rect>
    <path
      fill="var(--color-bg)"
      d="M24 9.5C24 9.5 17.6 16.4 17.6 23.1C17.6 25.4 18.6 27.1 20.2 27.9C19.5 26.8 19.2 25.6 19.4 24.4C19.8 22.1 21.7 20.6 23 18.7C23.5 20.3 24.4 21.6 25.7 22.6C28 24.4 29.4 26 29.4 28.4C29.4 31.8 26.6 34.6 23.2 34.6C19.5 34.6 16.5 31.7 16.5 27.9C16.5 23 20.4 18.7 24 9.5Z"
    ></path>
    <path
      fill="var(--color-accent)"
      d="M23.2 31.4C21.5 31.4 20.1 30 20.1 28.2C20.1 26.6 21.1 25.6 22 24.6C22.2 25.5 22.7 26.3 23.5 26.9C24.6 27.7 25.2 28.3 25.2 29.1C25.2 30.4 24.3 31.4 23.2 31.4Z"
    ></path>
  </svg>
  <span class="font-display whitespace-nowrap text-[19px] leading-none text-ink sm:text-[21px]">
    şömine <em class="text-accent">rehberi</em>
  </span>
</span>
