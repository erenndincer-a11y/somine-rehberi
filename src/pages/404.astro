---
import Base from '../layouts/Base.astro';
---

<Base title="Sayfa bulunamadı">
  <section class="mx-auto max-w-6xl px-5 pt-16 md:pt-24">
    <p class="eyebrow">404</p>
    <h1 class="font-display mt-4 max-w-2xl text-[clamp(32px,4.5vw,48px)] leading-[1.1]">Bu sayfa, bacası tıkanmış bir şömine gibi.</h1>
    <p class="mt-6 text-[16px] text-ink-secondary">
      Aradığın sayfa taşınmış ya da hiç var olmamış olabilir. <a class="text-accent underline underline-offset-2" href="/">Anasayfaya dön</a>.
    </p>
  </section>
</Base>
