---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, formatDate, readingTime, type Post } from '../../lib';
import { SITE, categoryName, categoryPath, categoryUrl, getCategory } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props as { post: Post; posts: Post[] };
const { data } = post;
const { Content } = await render(post);
const author = data.author ?? SITE.author;

// İlgili yazılar: önce aynı kategori, sonra ortak etiket, sonra en yeniler
const score = (p: Post) =>
  (p.data.category === data.category ? 10 : 0) + p.data.tags.filter((t) => data.tags.includes(t)).length;
const related = posts
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, s: score(p) }))
  .sort((a, b) => b.s - a.s || b.p.data.date.getTime() - a.p.data.date.getTime())
  .slice(0, 3)
  .map(({ p }) => p);

const url = new URL(`/yazi/${post.id}`, SITE.url).href;
const cat = getCategory(data.category);
const crumbs = [
  ...(cat?.parent ? [{ name: categoryName(cat.parent), href: categoryUrl(cat.parent) }] : []),
  { name: categoryName(data.category), href: categoryUrl(data.category) },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    image: new URL(data.image, SITE.url).href,
    datePublished: data.date.toISOString(),
    dateModified: (data.updated ?? data.date).toISOString(),
    articleSection: categoryPath(data.category),
    wordCount: post.body?.trim().split(/\s+/).length,
    author: { '@type': 'Organization', name: author },
    publisher: { '@type': 'Organization', name: SITE.name, logo: new URL('/android-chrome-512x512.png', SITE.url).href },
    mainEntityOfPage: url,
    inLanguage: 'tr',
    keywords: data.tags.join(', '),
  },
  ...(data.faq.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: data.faq.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: SITE.url },
      ...crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.name, item: new URL(c.href, SITE.url).href })),
      { '@type': 'ListItem', position: crumbs.length + 2, name: data.title, item: url },
    ],
  },
];
---

<Base
  title={data.title}
  description={data.description}
  image={data.image}
  type="article"
  jsonLd={jsonLd}
  markdownUrl={`/yazi/${post.id}.md`}
>
  <article class="mx-auto max-w-6xl px-5 pt-12 md:pt-16">
    <header class="mx-auto max-w-3xl">
      <p class="eyebrow">
        {
          crumbs.map((c, i) => (
            <>
              {i > 0 && ' › '}
              <a href={c.href} class="transition-colors hover:text-ink">
                {c.name}
              </a>
            </>
          ))
        }
        {' · '}<time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
      </p>
      <h1 class="font-display mt-4 text-[clamp(30px,4.5vw,52px)] leading-[1.1]">{data.title}</h1>
      <p class="mt-4 text-[13px] leading-[18px] text-ink-secondary">
        {author} · {readingTime(post.body)}
        {
          data.updated && (
            <>
              {' · '}Güncellendi: <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time>
            </>
          )
        }
      </p>
    </header>
    <div class="mx-auto mt-10 max-w-3xl">
      <div class="overflow-hidden rounded-thumb border border-border bg-surface-subtle">
        <img
          src={data.image}
          alt={data.imageAlt}
          width="1440"
          height="960"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="block h-auto w-full"
        />
      </div>
    </div>
    <div class="prose-post mx-auto mt-10 max-w-3xl">
      {
        data.keyPoints.length > 0 && (
          <aside class="mb-10 rounded-card border border-border bg-surface p-6" aria-labelledby="kisaca">
            <h2 id="kisaca" class="eyebrow !m-0 !font-sans !text-[12px] !leading-4 !tracking-[0.06em]">
              Kısaca
            </h2>
            <ul class="!mb-0 mt-3">
              {data.keyPoints.map((k) => (
                <li>{k}</li>
              ))}
            </ul>
          </aside>
        )
      }
      <Content />
      {
        data.faq.length > 0 && (
          <section aria-labelledby="sss">
            <h2 id="sss">Sık sorulan sorular</h2>
            {data.faq.map((f) => (
              <>
                <h3>{f.q}</h3>
                <p>{f.a}</p>
              </>
            ))}
          </section>
        )
      }
      {
        data.products.length > 0 && (
          <aside class="mt-10 rounded-card border border-border bg-surface p-6" aria-labelledby="urunler">
            <h2 id="urunler" class="eyebrow !m-0 !font-sans !text-[12px] !leading-4 !tracking-[0.06em]">
              Yazıdaki ürün
            </h2>
            <ul class="!mb-0 mt-3 list-none !pl-0">
              {data.products.map((p) => (
                <li class="!mb-2 flex flex-wrap items-baseline justify-between gap-x-4">
                  <a href={p.url} target="_blank" rel="noopener">
                    {p.name}
                  </a>
                  {p.price && <span class="text-[14px] text-ink-secondary">{p.price}</span>}
                </li>
              ))}
            </ul>
          </aside>
        )
      }
      {
        data.tags.length > 0 && (
          <ul class="mt-10 flex list-none flex-wrap gap-2 !pl-0" aria-label="Etiketler">
            {data.tags.map((t) => (
              <li class="!m-0 inline-flex h-9 items-center rounded-full bg-surface-subtle px-4 text-[12px] font-[550] tracking-[0.02em] text-ink-secondary">
                {t}
              </li>
            ))}
          </ul>
        )
      }
      {
        data.imageCredit && (
          <p class="mt-10 border-t border-border pt-4 text-[12px] leading-[18px] text-ink-secondary">
            Fotoğraf:{' '}
            {data.imageCreditUrl ? (
              <a href={data.imageCreditUrl} rel="nofollow noopener" class="text-ink-secondary underline underline-offset-2 transition-colors hover:text-ink">
                {data.imageCredit}
              </a>
            ) : (
              data.imageCredit
            )}
          </p>
        )
      }
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 pt-20" aria-labelledby="related-heading">
        <h2 id="related-heading" class="font-display text-[clamp(24px,3vw,32px)] leading-[1.15]">
          İlgili yazılar
        </h2>
        <div class="mt-8 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => <PostCard post={p} />)}
        </div>
      </section>
    )
  }
</Base>
