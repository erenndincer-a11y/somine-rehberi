---
import { topCategories, categoryUrl, type Category } from '../site.config';
interface Props {
  active?: string;
  items?: Category[];
}
const { active, items = topCategories } = Astro.props;
---

<ul class="flex flex-wrap gap-2">
  {
    items.map((c) => (
      <li>
        <a
          href={categoryUrl(c.slug)}
          aria-current={active === c.slug ? 'page' : undefined}
          class="inline-flex h-9 items-center rounded-full bg-surface-subtle px-4 text-[12px] font-[550] tracking-[0.02em] text-ink transition-colors hover:bg-accent-tint hover:text-accent aria-[current=page]:bg-accent-tint aria-[current=page]:text-accent"
        >
          {c.name}
        </a>
      </li>
    ))
  }
</ul>
