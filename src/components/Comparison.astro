---
// Karşılaştırma yazılarının üst bloğu: yan yana ürün kartları + özellik tablosu.
interface Item {
  name: string;
  short: string;
  url: string;
  image: string;
  bestFor: string;
}
interface Props {
  items: Item[];
  specs: { label: string; values: string[] }[];
}
const { items, specs } = Astro.props;
---

<section class="not-prose mb-12" aria-labelledby="karsilastirilanlar">
  <h2 id="karsilastirilanlar" class="eyebrow !m-0 !font-sans !text-[12px] !leading-4 !tracking-[0.06em]">Karşılaştırılan şömineler</h2>
  <div class="mt-4 grid grid-cols-2 gap-4 sm:gap-6">
    {
      items.map((it, i) => (
        <a href={it.url} target="_blank" rel="noopener" class="group block rounded-card border border-border bg-surface p-3 transition-colors hover:border-ink/25 sm:p-4">
          <div class="relative overflow-hidden rounded-thumb bg-[#f0f0f0]" style="aspect-ratio: 1/1">
            <img src={it.image} alt={it.name} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-contain" />
            <span class="absolute left-2 top-2 inline-flex h-7 w-7 items-center justify-center rounded-full bg-ink text-[13px] font-[600] text-white">
              {String.fromCharCode(65 + i)}
            </span>
          </div>
          <p class="font-display mt-3 text-[20px] leading-tight sm:text-[24px]">{it.short}</p>
          <p class="mt-1 text-[12px] leading-[17px] text-ink-secondary sm:text-[13px]">{it.name}</p>
          <p class="mt-3 border-t border-border pt-3 text-[13px] leading-[19px] sm:text-[14px]">
            <span class="font-[600]">Kime uygun:</span> {it.bestFor}
          </p>
          <p class="mt-3 text-[13px] font-[550] text-accent group-hover:underline">Ürün sayfası →</p>
        </a>
      ))
    }
  </div>

  {
    specs.length > 0 && (
      <dl class="mt-8 divide-y divide-border rounded-card border border-border bg-surface sm:hidden">
        {specs.map((s) => {
          const same = s.values.every((v) => v === s.values[0]);
          return (
            <div class="px-4 py-3">
              <dt class="text-[12px] font-[550] tracking-[0.04em] text-ink-secondary">{s.label}</dt>
              {same ? (
                <dd class="mt-1 text-[14px]">{s.values[0]} <span class="text-[12px] text-ink-secondary">(ikisinde de)</span></dd>
              ) : (
                <dd class="mt-2 grid grid-cols-2 gap-2">
                  {s.values.map((v, i) => (
                    <span class="rounded-btn bg-accent-tint px-2.5 py-2 text-[13px] leading-[18px] text-accent-hover">
                      <b class="font-[650]">{items[i]?.short}:</b> {v}
                    </span>
                  ))}
                </dd>
              )}
            </div>
          );
        })}
      </dl>
      <div class="mt-8 hidden overflow-x-auto rounded-card border border-border bg-surface sm:block">
        <table class="w-full border-collapse text-left text-[14px] leading-[20px]">
          <caption class="sr-only">Özellik karşılaştırması</caption>
          <thead>
            <tr class="border-b border-border bg-surface-subtle">
              <th scope="col" class="w-[28%] px-4 py-3 text-[12px] font-[550] tracking-[0.04em] text-ink-secondary">Özellik</th>
              {items.map((it, i) => (
                <th scope="col" class="px-4 py-3 font-[600]">
                  {String.fromCharCode(65 + i)} · {it.short}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {specs.map((s) => {
              const same = s.values.every((v) => v === s.values[0]);
              return (
                <tr class="border-b border-border last:border-0">
                  <th scope="row" class="px-4 py-3 font-[500] text-ink-secondary">{s.label}</th>
                  {s.values.map((v) => (
                    <td class:list={['px-4 py-3 align-top', !same && 'font-[550] text-accent-hover']}>{v}</td>
                  ))}
                </tr>
              );
            })}
          </tbody>
        </table>
        <p class="border-t border-border px-4 py-2 text-[12px] text-ink-secondary">
          Vurgulu satırlar iki model arasındaki farkları gösterir. Bilgiler Yanar Şömine ürün sayfalarından ve ürün fotoğraflarından alınmıştır.
        </p>
      </div>
      <p class="mt-3 text-[12px] text-ink-secondary sm:hidden">Bilgiler Yanar Şömine ürün sayfalarından ve ürün fotoğraflarından alınmıştır.</p>
    )
  }
</section>
